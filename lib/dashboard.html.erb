<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PR cycle time</title>
<style>
  :root {
    color-scheme: light;
    --surface-1: #fcfcfb; --surface-2: #f2f2f0; --border: #dcdcd8;
    --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77766f;
    --pickup: #2a78d6; --review: #eb6834; --merge-wait: #1baf7a;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --surface-1: #1a1a19; --surface-2: #232322; --border: #3a3a38;
      --text-primary: #ffffff; --text-secondary: #c3c2b7; --text-muted: #94938a;
      --pickup: #3987e5; --review: #d95926; --merge-wait: #199e70;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --surface-1: #1a1a19; --surface-2: #232322; --border: #3a3a38;
    --text-primary: #ffffff; --text-secondary: #c3c2b7; --text-muted: #94938a;
    --pickup: #3987e5; --review: #d95926; --merge-wait: #199e70;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1.5rem 4rem; background: var(--surface-1); color: var(--text-primary);
    font: 15px/1.55 ui-sans-serif, -apple-system, "Segoe UI", system-ui, sans-serif;
  }
  .wrap { max-width: 1180px; margin: 0 auto; }
  h1 { font-size: 1.4rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .sub { color: var(--text-secondary); margin: 0 0 1.75rem; font-size: .875rem; }
  .filters {
    display: flex; flex-wrap: wrap; gap: .75rem 1rem; padding: 1rem; margin-bottom: 1.75rem;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;
  }
  .field { display: flex; flex-direction: column; gap: .3rem; }
  .field label { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
  select, input {
    font: inherit; font-size: .875rem; padding: .35rem .5rem; color: var(--text-primary);
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 6px; min-width: 8.5rem;
  }
  input[type=number] { min-width: 5.5rem; }
  button {
    font: inherit; font-size: .8rem; padding: .4rem .8rem; cursor: pointer; align-self: flex-end;
    color: var(--text-primary); background: var(--surface-1); border: 1px solid var(--border); border-radius: 6px;
  }
  details.ms { position: relative; }
  details.ms > summary {
    list-style: none; cursor: pointer; font: inherit; font-size: .875rem; padding: .35rem .5rem;
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 6px; min-width: 8.5rem;
    display: flex; justify-content: space-between; gap: .5rem; align-items: center;
  }
  details.ms > summary::-webkit-details-marker { display: none; }
  details.ms > summary::after { content: "▾"; color: var(--text-muted); font-size: .7rem; }
  details.ms[open] > summary { border-color: var(--text-muted); }
  .ms-list {
    position: absolute; z-index: 20; top: 100%; left: 0; margin-top: 4px; min-width: 100%; max-height: 16rem;
    overflow-y: auto; background: var(--surface-1); border: 1px solid var(--border); border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,.2); padding: .35rem;
  }
  .ms-list label {
    display: flex; gap: .45rem; align-items: center; padding: .25rem .4rem; border-radius: 5px;
    font-size: .85rem; text-transform: none; letter-spacing: 0; color: var(--text-primary); white-space: nowrap;
  }
  .ms-list label:hover { background: var(--surface-2); }
  .ms-list input { min-width: 0; margin: 0; }
  .panel {
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;
    padding: .9rem 1.1rem; margin-bottom: 2rem;
  }
  .panel ul { margin: 0; padding-left: 1.1rem; }
  .panel li { margin: .3rem 0; font-size: .875rem; color: var(--text-secondary); }
  .panel li b { color: var(--text-primary); font-weight: 600; }
  .scroll { overflow-x: auto; }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--text-primary); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 1.75rem; }
  .bar-cell { display: flex; align-items: center; gap: .5rem; }
  .bar-cell span { height: 8px; border-radius: 2px; display: inline-block; }
  .tiles { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; }
  .tile { flex: 1 1 8rem; padding: .85rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; }
  .tile .k { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
  .tile .v { font-size: 1.5rem; font-variant-numeric: tabular-nums; margin-top: .15rem; }
  .legend { display: flex; gap: 1.25rem; margin: 0 0 .5rem; font-size: .8rem; color: var(--text-secondary); }
  .legend i { display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: .4rem; vertical-align: -1px; }
  .chartbox { overflow-x: auto; margin-bottom: 2.25rem; }
  svg { display: block; }
  svg text { fill: var(--text-secondary); font-size: 11px; }
  svg text.total { fill: var(--text-primary); font-size: 11px; font-variant-numeric: tabular-nums; }
  svg .grid { stroke: var(--border); stroke-width: 1; }
  h2 { font-size: .95rem; margin: 2rem 0 .6rem; }
  table { border-collapse: collapse; width: 100%; font-size: .825rem; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th { color: var(--text-muted); font-weight: 600; font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.wide { white-space: normal; }
  a { color: inherit; }
  .swatch { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: .35rem; }
  .flag { color: var(--text-muted); font-size: .7rem; }
  .empty { color: var(--text-muted); padding: 2rem 0; }
  .tt {
    position: fixed; pointer-events: none; opacity: 0; transition: opacity .1s; z-index: 10;
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 7px;
    padding: .5rem .65rem; font-size: .78rem; box-shadow: 0 6px 20px rgba(0,0,0,.18); max-width: 16rem;
  }
  .tt b { display: block; margin-bottom: .25rem; }
</style>
</head>
<body>
<div class="wrap">
  <h1>PR cycle time</h1>
  <p class="sub">
    Working hours only — Sunday to Thursday, 09:00–18:00 Amman. Public holidays are not counted.
    <%= rows.size %> merged PRs · synced <%= generated %>
  </p>

  <div class="filters" id="filters"></div>
  <div class="tiles" id="tiles"></div>

  <div class="legend">
    <span><i style="background:var(--pickup)"></i>pickup — waiting for a first human response</span>
    <span><i style="background:var(--review)"></i>review — first response to last approval</span>
    <span><i style="background:var(--merge-wait)"></i>merge-wait — approved but not merged</span>
  </div>
  <div class="chartbox"><svg id="chart" role="img" aria-label="Median hours per stage"></svg></div>

  <h2>What is slow, and why</h2>
  <div class="panel"><ul id="why"></ul></div>

  <h2>Engineers <span class="flag">— click any column to sort</span></h2>
  <div class="scroll"><table id="engineers"></table></div>

  <h2>Teams</h2>
  <table id="teams"></table>

  <h2>Per bucket</h2>
  <table id="buckets"></table>

  <h2>Slowest PRs</h2>
  <table id="slowest"></table>
</div>
<div class="tt" id="tt"></div>

<script id="rows" type="application/json"><%= rows_json %></script>
<script id="teams-map" type="application/json"><%= teams_json %></script>
<script>
const ROWS = JSON.parse(document.getElementById('rows').textContent);
const STAGES = [['pickup', 'pickup'], ['review', 'review'], ['merge_wait', 'merge-wait']];
const MIN_N = 10;
const MIN_REVIEWS = 5; // below this a reviewer median is noise, not a ranking
const F = {}; // active filter state

const uniq = (key) => [...new Set(ROWS.flatMap(r => Array.isArray(r[key]) ? r[key] : [r[key]]))]
  .filter(v => v !== null && v !== undefined && v !== '').sort();

const hours = (s, d = 1) => s === null || s === undefined ? '—' : (s / 3600).toFixed(d) + 'h';

function percentile(values, p) {
  if (!values.length) return null;
  const v = [...values].sort((a, b) => a - b);
  const rank = p * (v.length - 1), lo = Math.floor(rank), hi = Math.ceil(rank);
  return v[lo] + (v[hi] - v[lo]) * (rank - lo);
}

const suffix = () => F.clock === 'wall' ? '_s' : '_bh_s';

function filtered() {
  return ROWS.filter(r => {
    if (F.repo.size && !F.repo.has(r.repo)) return false;
    if (F.team.size && !F.team.has(r.team)) return false;
    if (F.author.size && !F.author.has(r.author)) return false;
    if (F.reviewer.size && !r.reviewers.some(v => F.reviewer.has(v))) return false;
    if (F.label.size && !r.labels.some(v => F.label.has(v))) return false;
    if (F.base.size && !F.base.has(r.base_branch)) return false;
    if (F.since && r.merged_at < F.since) return false;
    if (F.until && r.merged_at > F.until + 'T23:59:59Z') return false;
    if (F.min_size && r.lines_changed < +F.min_size) return false;
    if (F.max_size && r.lines_changed > +F.max_size) return false;
    return true;
  });
}

function bucketKey(r) {
  const m = r.merged_at;
  switch (F.group) {
    case 'month': return m.slice(0, 7);
    case 'quarter': return m.slice(0, 4) + '-Q' + (Math.floor((+m.slice(5, 7) - 1) / 3) + 1);
    case 'year': return m.slice(0, 4);
    case 'all': return 'all time';
    default: return r.week;
  }
}

function group(rows) {
  const out = new Map();
  const push = (k, r) => { if (!out.has(k)) out.set(k, []); out.get(k).push(r); };
  for (const r of rows) {
    if (F.group === 'reviewer') (r.reviewers.length ? r.reviewers : ['(none)']).forEach(v => push(v, r));
    else if (F.group === 'label') (r.labels.length ? r.labels : ['(none)']).forEach(v => push(v, r));
    else if (['repo', 'author', 'team'].includes(F.group)) push(r[F.group === 'repo' ? 'repo' : F.group] || '(none)', r);
    else push(bucketKey(r), r);
  }
  return [...out.entries()].sort((a, b) => a[0] < b[0] ? -1 : 1);
}

function summarize(name, rows) {
  const sfx = suffix();
  const scored = rows.filter(r => r['total' + sfx] !== null);
  const stages = {};
  for (const [key] of STAGES) {
    const vals = scored.map(r => r[key + sfx]).filter(v => v !== null);
    stages[key] = { median: percentile(vals, 0.5), p75: percentile(vals, 0.75) };
  }
  const bottleneck = STAGES.map(([k]) => k).reduce((a, b) => (stages[a].median || 0) >= (stages[b].median || 0) ? a : b);
  return {
    name, rows, n: scored.size || scored.length, stages, bottleneck,
    total: percentile(scored.map(r => r['total' + sfx]), 0.5),
    wall: percentile(scored.map(r => r.total_s), 0.5),
    flagged: rows.filter(r => r.flags.length).length,
    suppressed: scored.length < MIN_N
  };
}

/* ---------- filters ---------- */
const FIELDS = [
  ['repo', 'repo', 'repo'], ['team', 'team', 'team'], ['author', 'author', 'author'],
  ['reviewer', 'reviewers', 'reviewer'], ['label', 'labels', 'label'], ['base', 'base_branch', 'base branch']
];

function buildFilters() {
  const box = document.getElementById('filters');
  const field = (label, el) => {
    const d = document.createElement('div'); d.className = 'field';
    const l = document.createElement('label'); l.textContent = label;
    d.append(l, el); box.append(d); return el;
  };
  const select = (name, options, labelText, initial) => {
    const s = document.createElement('select');
    s.innerHTML = options.map(o => `<option value="${o[0]}">${o[1]}</option>`).join('');
    s.value = initial ?? '';
    F[name] = s.value;
    s.onchange = () => { F[name] = s.value; render(); };
    return field(labelText, s);
  };

  // multi-select: native details + checkboxes, no library, keyboard reachable
  const multi = (name, values, labelText) => {
    F[name] = new Set();
    const d = document.createElement('details'); d.className = 'ms';
    const sum = document.createElement('summary'); sum.textContent = 'all';
    const list = document.createElement('div'); list.className = 'ms-list';
    values.forEach(v => {
      const l = document.createElement('label');
      const cb = document.createElement('input'); cb.type = 'checkbox'; cb.value = v;
      cb.onchange = () => {
        cb.checked ? F[name].add(v) : F[name].delete(v);
        sum.textContent = F[name].size === 0 ? 'all'
          : F[name].size === 1 ? [...F[name]][0] : F[name].size + ' selected';
        render();
      };
      l.append(cb, document.createTextNode(v));
      list.append(l);
    });
    d.append(sum, list);
    document.addEventListener('click', e => { if (!d.contains(e.target)) d.open = false; });
    return field(labelText, d);
  };

  select('group', [['week', 'week'], ['month', 'month'], ['quarter', 'quarter'], ['year', 'year'],
                   ['all', 'all time'], ['repo', 'repo'], ['team', 'team'], ['author', 'author'],
                   ['reviewer', 'reviewer'], ['label', 'label']], 'group by', 'week');
  select('clock', [['bh', 'working hours'], ['wall', 'elapsed']], 'clock', 'bh');
  for (const [name, key, labelText] of FIELDS) multi(name, uniq(key), labelText);
  for (const [name, labelText] of [['since', 'merged from'], ['until', 'merged to']]) {
    const i = document.createElement('input'); i.type = 'date';
    i.onchange = () => { F[name] = i.value; render(); };
    field(labelText, i);
  }
  for (const [name, labelText] of [['min_size', 'min lines'], ['max_size', 'max lines']]) {
    const i = document.createElement('input'); i.type = 'number'; i.min = 0; i.placeholder = '—';
    i.oninput = () => { F[name] = i.value; render(); };
    field(labelText, i);
  }
  const reset = document.createElement('button');
  reset.textContent = 'Reset';
  reset.onclick = () => location.reload();
  box.append(reset);
}

/* ---------- chart ---------- */
const tt = document.getElementById('tt');
function showTip(e, html) {
  tt.innerHTML = html; tt.style.opacity = 1;
  tt.style.left = Math.min(e.clientX + 14, innerWidth - tt.offsetWidth - 10) + 'px';
  tt.style.top = Math.max(e.clientY - tt.offsetHeight - 12, 8) + 'px';
}
const hideTip = () => { tt.style.opacity = 0; };

function drawChart(buckets) {
  const svg = document.getElementById('chart');
  const shown = buckets.filter(b => !b.suppressed);
  const H = 300, PAD_T = 26, PAD_B = 46, PAD_L = 46;
  const colW = Math.max(62, Math.min(160, Math.floor(980 / Math.max(buckets.length, 1))));
  const W = PAD_L + colW * buckets.length + 10;
  const peak = Math.max(...shown.map(b => STAGES.reduce((s, [k]) => s + (b.stages[k].median || 0), 0)), 1);
  const max = peak * 1.08; // headroom for the total label above the tallest bar
  const y = v => (H - PAD_B) - (v / max) * (H - PAD_T - PAD_B);
  const el = (n, a, kids) => {
    const e = document.createElementNS('http://www.w3.org/2000/svg', n);
    for (const k in a) e.setAttribute(k, a[k]);
    (kids || []).forEach(c => e.append(c));
    return e;
  };

  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.setAttribute('width', W); svg.setAttribute('height', H);
  svg.replaceChildren();

  // round grid steps, so the axis never reads 0h 2h 3h 5h 6h
  const STEPS = [0.25, 0.5, 1, 2, 4, 8, 12, 24, 48, 96, 168, 336, 720];
  const step = (STEPS.find(h => max / 3600 / h <= 5) || 720) * 3600;
  for (let v = 0; v <= max + step / 2; v += step) {
    svg.append(el('line', { class: 'grid', x1: PAD_L - 6, x2: W, y1: y(v), y2: y(v) }));
    const t = el('text', { x: PAD_L - 10, y: y(v) + 4, 'text-anchor': 'end' });
    t.textContent = (v / 3600).toFixed(step < 3600 ? 2 : 0) + 'h';
    svg.append(t);
  }

  buckets.forEach((b, i) => {
    const x = PAD_L + i * colW + 8, bw = colW - 18;
    const lab = el('text', { x: x + bw / 2, y: H - PAD_B + 16, 'text-anchor': 'middle' });
    lab.textContent = b.name.length > 11 ? b.name.slice(0, 10) + '…' : b.name;
    const t = el('title'); t.textContent = b.name; lab.append(t);
    svg.append(lab);

    if (b.suppressed) {
      const note = el('text', { x: x + bw / 2, y: H - PAD_B - 6, 'text-anchor': 'middle' });
      note.textContent = 'n=' + b.rows.length;
      svg.append(note);
      return;
    }
    let acc = 0, total = STAGES.reduce((s, [k]) => s + (b.stages[k].median || 0), 0);
    STAGES.forEach(([key, label], si) => {
      const v = b.stages[key].median || 0;
      if (v <= 0) return;
      const top = y(acc + v), bottom = y(acc), h = Math.max(bottom - top - 2, 1);
      const rect = el('rect', {
        x, y: top, width: bw, height: h, fill: `var(--${label})`,
        rx: si === STAGES.length - 1 ? 4 : 0
      });
      rect.addEventListener('mousemove', e => showTip(e,
        `<b>${b.name}</b>${label}: ${hours(v)}<br>p75 ${hours(b.stages[key].p75)}<br>n=${b.n}`));
      rect.addEventListener('mouseleave', hideTip);
      svg.append(rect);
      acc += v;
    });
    const tl = el('text', { class: 'total', x: x + bw / 2, y: y(total) - 7, 'text-anchor': 'middle' });
    tl.textContent = hours(total, total / 3600 >= 10 ? 0 : 1);
    svg.append(tl);
  });
}

/* ---------- tables ---------- */
function drawBuckets(buckets) {
  const head = `<tr><th>${F.group}</th><th class="num">n</th>` +
    STAGES.map(([, l]) => `<th class="num">${l}</th>`).join('') +
    `<th class="num">total</th><th class="num">elapsed</th><th>bottleneck</th><th class="num">flagged</th></tr>`;
  const body = buckets.map(b => {
    if (b.suppressed) {
      return `<tr><td>${b.name}</td><td class="num">${b.rows.length}</td>` +
             `<td colspan="6" class="flag">below ${MIN_N} PRs — median suppressed</td></tr>`;
    }
    return `<tr><td>${b.name}</td><td class="num">${b.n}</td>` +
      STAGES.map(([k, l]) =>
        `<td class="num"><span class="swatch" style="background:var(--${l})"></span>${hours(b.stages[k].median)}` +
        `<span class="flag"> / ${hours(b.stages[k].p75, 0)}</span></td>`).join('') +
      `<td class="num">${hours(b.total)}</td><td class="num flag">${hours(b.wall, 0)}</td>` +
      `<td>${b.bottleneck.replace('_', '-')}</td><td class="num">${b.flagged || ''}</td></tr>`;
  }).join('');
  document.getElementById('buckets').innerHTML = head + body;
}

function drawSlowest(rows) {
  const sfx = suffix();
  const top = rows.filter(r => r['total' + sfx] !== null)
                  .sort((a, b) => b['total' + sfx] - a['total' + sfx]).slice(0, 10);
  const head = `<tr><th>PR</th><th>author</th><th class="num">total</th>` +
    STAGES.map(([, l]) => `<th class="num">${l}</th>`).join('') + `<th>flags</th></tr>`;
  const body = top.map(r =>
    `<tr><td class="wide"><a href="${r.url}">${r.repo}#${r.number}</a> ${r.title.slice(0, 64)}</td>` +
    `<td>${r.author}</td><td class="num">${hours(r['total' + sfx], 0)}</td>` +
    STAGES.map(([k, l]) =>
      `<td class="num"><span class="swatch" style="background:var(--${l})"></span>${hours(r[k + sfx], 0)}</td>`).join('') +
    `<td class="flag">${r.flags.join(' ')}</td></tr>`).join('');
  document.getElementById('slowest').innerHTML = head + body;
}

function drawTiles(rows, buckets) {
  const all = summarize('all', rows);
  const tiles = [
    ['PRs', rows.length],
    ['median cycle', hours(all.total)],
    ['p75 pickup', hours(percentile(rows.map(r => r['pickup' + suffix()]).filter(v => v !== null), 0.75))],
    ['bottleneck', all.n >= MIN_N ? all.bottleneck.replace('_', '-') : '—'],
    ['flagged', all.flagged]
  ];
  document.getElementById('tiles').innerHTML = tiles
    .map(([k, v]) => `<div class="tile"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('');
}

/* ---------- rankings ---------- */
const TEAM_OF = JSON.parse(document.getElementById('teams-map').textContent);

// One row per engineer — everyone who authored or touched a PR in the current filter.
// Response time is THEIR time to first touch, not the PR's pickup, which belongs to
// whoever answered first.
function engineerStats(rows) {
  const sfx = F.clock === 'wall' ? 's' : 'bh_s';
  const acc = new Map();
  const get = login => {
    if (!acc.has(login)) {
      acc.set(login, {
        login, team: TEAM_OF[login] || '(no team)',
        authored: 0, lines: 0, cycles: [],
        reviewed: 0, touched: 0, first: 0, times: [], comments: 0, silent: 0
      });
    }
    return acc.get(login);
  };
  for (const r of rows) {
    const a = get(r.author);
    a.authored++;
    a.lines += r.lines_changed || 0;
    if (r['total' + (F.clock === 'wall' ? '_s' : '_bh_s')] !== null) {
      a.cycles.push(r['total' + (F.clock === 'wall' ? '_s' : '_bh_s')]);
    }
    for (const [login, v] of Object.entries(r.responses)) {
      const e = get(login);
      e.touched++;
      e.times.push(v[sfx]);
      e.comments += v.comments || 0;
      if (v.reviewed) e.reviewed++;
      if (v.silent) e.silent++;
      if (r.first_responder === login) e.first++;
    }
  }
  return [...acc.values()].map(e => ({
    ...e,
    median: e.times.length ? percentile(e.times, 0.5) : null,
    cycle: e.cycles.length ? percentile(e.cycles, 0.5) : null,
    ratio: e.touched ? e.comments / e.touched : null,
    silentPct: e.reviewed ? e.silent / e.reviewed : null
  }));
}

const ENG_COLS = [
  { key: 'login', label: 'engineer', dir: 1, cell: e => `${e.login}<div class="flag">${e.team}</div>` },
  { key: 'authored', label: 'PRs', num: true, cell: e => e.authored },
  { key: 'lines', label: 'lines', num: true, cell: e => e.lines.toLocaleString() },
  { key: 'cycle', label: 'own cycle', num: true, cell: e => e.authored >= 3 ? hours(e.cycle) : '<span class="flag">—</span>' },
  { key: 'touched', label: 'reviewed', num: true, cell: e => e.touched },
  { key: 'median', label: 'responds in', num: true,
    cell: e => e.touched >= MIN_REVIEWS ? hours(e.median) : `<span class="flag">${hours(e.median)}</span>` },
  { key: 'first', label: 'first in', num: true, cell: e => e.first },
  { key: 'comments', label: 'comments', num: true, cell: e => e.comments },
  { key: 'ratio', label: 'per PR', num: true, cell: e => e.ratio === null ? '—' : e.ratio.toFixed(2) },
  { key: 'silent', label: 'silent', num: true,
    cell: e => !e.reviewed ? '<span class="flag">—</span>'
      : `${e.silent}<span class="flag"> / ${(e.silentPct * 100).toFixed(0)}%</span>` }
];

let ENG_SORT = { key: 'touched', dir: -1 };

function drawEngineers(rows) {
  const stats = engineerStats(rows);
  const { key, dir } = ENG_SORT;
  stats.sort((x, y) => {
    const a = x[key], b = y[key];
    if (a === null || a === undefined) return 1;
    if (b === null || b === undefined) return -1;
    return typeof a === 'string' ? a.localeCompare(b) * dir : (a - b) * dir;
  });
  const head = '<tr>' + ENG_COLS.map(c =>
    `<th class="${c.num ? 'num ' : ''}sortable" data-key="${c.key}">${c.label}` +
    `${key === c.key ? (dir === -1 ? ' ↓' : ' ↑') : ''}</th>`).join('') + '</tr>';
  const body = stats.map(e => '<tr>' + ENG_COLS.map(c =>
    `<td class="${c.num ? 'num' : ''}">${c.cell(e)}</td>`).join('') + '</tr>').join('');
  const table = document.getElementById('engineers');
  table.innerHTML = head + body;
  table.querySelectorAll('th.sortable').forEach(th => {
    th.onclick = () => {
      const k = th.dataset.key;
      ENG_SORT = { key: k, dir: ENG_SORT.key === k ? -ENG_SORT.dir : (k === 'login' ? 1 : -1) };
      drawEngineers(rows);
    };
  });
}

// kept for the diagnostics panel: only people with enough reviews to rank
function reviewerStats(rows) {
  return engineerStats(rows).map(e => ({ ...e, prs: e.touched })).filter(e => e.median !== null);
}

function teamStats(rows) {
  const sfx = suffix();
  const acc = new Map();
  const get = t => {
    if (!acc.has(t)) acc.set(t, { team: t, authored: [], reviewed: [] });
    return acc.get(t);
  };
  for (const r of rows) {
    if (r['total' + sfx] !== null) get(r.team).authored.push(r['total' + sfx]);
    const seen = new Set();
    for (const [login, v] of Object.entries(r.responses)) {
      const t = TEAM_OF[login] || '(no team)';
      if (seen.has(t)) continue;
      seen.add(t);
      get(t).reviewed.push(v[F.clock === 'wall' ? 's' : 'bh_s']);
    }
  }
  return [...acc.values()].map(a => ({
    ...a, cycle: percentile(a.authored, 0.5), response: percentile(a.reviewed, 0.5)
  }));
}

function rankTable(id, head, rowsHtml) {
  document.getElementById(id).innerHTML = head + rowsHtml;
}

function drawTeams(rows) {
  const stats = teamStats(rows).sort((a, b) => (b.response ?? -1) - (a.response ?? -1));
  const head = `<tr><th>team</th><th class="num">PRs</th><th class="num">cycle</th>` +
               `<th class="num">reviews in</th></tr>`;
  const body = stats.map(t =>
    `<tr><td>${t.team}</td><td class="num">${t.authored.length}</td>` +
    `<td class="num">${t.authored.length >= MIN_N ? hours(t.cycle) : '<span class="flag">n&lt;' + MIN_N + '</span>'}</td>` +
    `<td class="num">${t.reviewed.length >= 3 ? hours(t.response) : '<span class="flag">—</span>'}</td></tr>`).join('');
  rankTable('teams', head, body);
}

/* ---------- diagnostics ---------- */
function drawWhy(rows) {
  const sfx = suffix();
  const scored = rows.filter(r => r['total' + sfx] !== null);
  const out = [];
  const say = (h) => out.push(`<li>${h}</li>`);
  const med = (vals) => percentile(vals.filter(v => v !== null), 0.5);

  if (scored.length) {
    // 1. which stage, and how much of the whole it holds
    const totals = {};
    for (const [k, l] of STAGES) totals[l] = scored.reduce((a, r) => a + (r[k + sfx] || 0), 0);
    const sum = Object.values(totals).reduce((a, b) => a + b, 0) || 1;
    const worst = Object.entries(totals).sort((a, b) => b[1] - a[1])[0];
    say(`<b>${worst[0]}</b> holds <b>${(worst[1] / sum * 100).toFixed(0)}%</b> of all waiting time ` +
        `(${Object.entries(totals).map(([l, v]) => `${l} ${(v / sum * 100).toFixed(0)}%`).join(' · ')}).`);

    // 2. tail or systemic
    const sorted = scored.map(r => r['total' + sfx]).sort((a, b) => b - a);
    const topN = Math.max(1, Math.round(sorted.length * 0.2));
    const tail = sorted.slice(0, topN).reduce((a, b) => a + b, 0) / (sorted.reduce((a, b) => a + b, 0) || 1);
    say(tail > 0.6
      ? `Tail-driven: the slowest <b>${topN}</b> PRs hold <b>${(tail * 100).toFixed(0)}%</b> of the waiting. Fix those PRs, not the process.`
      : `Systemic: the slowest <b>${topN}</b> PRs hold only <b>${(tail * 100).toFixed(0)}%</b> of the waiting. It is spread across the whole set.`);

    // 3. off-hours share
    const wall = med(scored.map(r => r.total_s)), work = med(scored.map(r => r.total_bh_s));
    if (wall && work) {
      say(`<b>${(100 - work / wall * 100).toFixed(0)}%</b> of elapsed time is outside working hours ` +
          `(median ${hours(wall, 0)} elapsed vs ${hours(work)} at work).`);
    }

    // 4. does size explain it
    const sizes = scored.map(r => r.lines_changed).sort((a, b) => a - b);
    const cut = sizes[Math.floor(sizes.length / 2)];
    const big = med(scored.filter(r => r.lines_changed > cut).map(r => r['total' + sfx]));
    const small = med(scored.filter(r => r.lines_changed <= cut).map(r => r['total' + sfx]));
    if (big && small) {
      const ratio = big / small;
      say(ratio >= 1.5
        ? `Size matters: PRs over <b>${cut}</b> lines take <b>${ratio.toFixed(1)}×</b> longer (${hours(big)} vs ${hours(small)}).`
        : `Size is not the driver: over <b>${cut}</b> lines is only ${ratio.toFixed(1)}× (${hours(big)} vs ${hours(small)}).`);
    }

    // 5. when a PR goes ready — only worth saying when it actually differs
    const isLate = r => (+r.ready_at.slice(11, 13) + 3) % 24 >= 15;
    const late = scored.filter(isLate), early = scored.filter(r => !isLate(r));
    if (late.length >= 5 && early.length >= 5) {
      const l = med(late.map(r => r['pickup' + sfx])), e = med(early.map(r => r['pickup' + sfx]));
      if (l && e) {
        const ratio = l / e;
        say(ratio >= 1.3 || ratio <= 0.77
          ? `Ready after 15:00 Amman waits <b>${ratio.toFixed(1)}×</b> ${ratio >= 1 ? 'longer' : 'less'} for pickup ` +
            `(${hours(l)} vs ${hours(e)}, ${late.length} of ${scored.length} PRs).`
          : `Time of day is not a driver: pickup ${hours(l)} after 15:00 vs ${hours(e)} before.`);
      }
    }
  }

  // 6. who the queue is
  const rev = reviewerStats(rows).filter(s => s.prs >= MIN_REVIEWS).sort((a, b) => b.median - a.median);
  if (rev.length >= 2) {
    const slow = rev[0], fast = rev[rev.length - 1];
    say(`Slowest to respond: <b>${slow.login}</b> (${slow.team}) ${hours(slow.median)} over ${slow.prs} PRs. ` +
        `Fastest: <b>${fast.login}</b> (${fast.team}) ${hours(fast.median)} over ${fast.prs}. ` +
        `<span class="flag">${MIN_REVIEWS}+ PRs each</span>`);
  }

  // 7. review coverage
  const noReview = rows.filter(r => r.flags.includes('no_review')).length;
  const noApproval = rows.filter(r => r.flags.includes('no_approval')).length;
  if (noReview || noApproval) {
    say(`<b>${noReview}</b> merged with no human response at all, <b>${noApproval}</b> with a response but no approval.`);
  }

  document.getElementById('why').innerHTML = out.join('') || '<li>Not enough data for these filters.</li>';
}

function render() {
  const rows = filtered();
  if (!rows.length) {
    document.getElementById('tiles').innerHTML = '<p class="empty">No PRs match these filters.</p>';
    document.getElementById('chart').replaceChildren();
    document.getElementById('buckets').innerHTML = '';
    document.getElementById('slowest').innerHTML = '';
    document.getElementById('why').innerHTML = '<li>No PRs match these filters.</li>';
    document.getElementById('engineers').innerHTML = '';
    document.getElementById('teams').innerHTML = '';
    return;
  }
  const buckets = group(rows).map(([name, rs]) => summarize(name, rs));
  drawTiles(rows, buckets);
  drawChart(buckets);
  drawBuckets(buckets);
  drawSlowest(rows);
  drawWhy(rows);
  drawEngineers(rows);
  drawTeams(rows);
}

buildFilters();
render();
</script>
</body>
</html>
